# Frontend (Vite) — safe to expose, these are public anon keys by design
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend only (Vercel serverless function) — set these in Vercel dashboard,
# NEVER prefix with VITE_ or they'll be bundled into the browser.
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
